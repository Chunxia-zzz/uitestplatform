# 复制为 .env 后按需修改（前缀 UIP_）

# 环境：dev / test / prod
UIP_ENV=dev
UIP_LOG_LEVEL=INFO

# 数据库：默认 SQLite（零依赖起步）
UIP_DATABASE_URL=sqlite+aiosqlite:///./data/uitest.db
# 生产 MySQL：
# UIP_DATABASE_URL=mysql+aiomysql://uitest:password@127.0.0.1:3306/uitest?charset=utf8mb4
UIP_DB_ECHO=false

# D11：run_python 默认禁用，需显式开启（受限命名空间 + 超时强杀）
UIP_ALLOW_RUN_PYTHON=false
UIP_RUN_PYTHON_TIMEOUT_S=5

# 树形（D15）
UIP_MAX_TREE_DEPTH=8

# 执行 / 定位符验证
UIP_DEFAULT_TIMEOUT_MS=15000
# GAP-03/Q-05：断言在 timeout_ms 窗口内的轮询间隔（不设固定重试次数）
UIP_ASSERT_POLL_INTERVAL_MS=200
UIP_VERIFY_TOTAL_TIMEOUT_S=30
UIP_VERIFY_PROBE_TIMEOUT_S=5
UIP_VERIFY_MAX_LOCATORS=20
UIP_HEADLESS=true

# M3.1 执行内核（D21/D23）
UIP_MAX_CONCURRENT_EXECUTIONS=2
UIP_MAX_PENDING=200
UIP_REPORT_DIR=./reports
UIP_EVENT_LOG_DIR=./events

UIP_ARTIFACTS_DIR=./artifacts

# ── M3.6 GAP-08：诊断录制（D35）────────────────────────────
# trace 模式：off / on-failure（失败才存 trace.zip）/ always
UIP_TRACE=on-failure
# 全程录屏（开启即全程录制，Playwright 无法按结果取舍；注意磁盘占用）
UIP_VIDEO=false
# 全程录制 HAR
UIP_HAR=false

# ── M3.6 GAP-20 / M3.7 GAP-43：通知（D32/D33/D39/D41）────────
# 渠道单选：wecom（默认）/ feishu
UIP_NOTIFY_CHANNEL=wecom
# 企微 webhook 完整 URL；留空 = 该渠道禁用推送
# UIP_NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# 飞书自定义机器人 webhook；留空 = 该渠道禁用推送
# UIP_NOTIFY_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 飞书机器人「自定义关键词」（会写进卡片标题；机器人未开关键词则留空）
UIP_NOTIFY_FEISHU_KEYWORD=UI自动化平台
# 推送门控：none / failure（FAILED+ERROR）/ all
UIP_NOTIFY_ON=failure
# 单次推送超时（秒）
UIP_NOTIFY_TIMEOUT_S=5

# 对外可访问的平台基址（通知消息里拼报告链接；留空 = 消息不带链接）
# UIP_PUBLIC_BASE_URL=http://your-host:5173
